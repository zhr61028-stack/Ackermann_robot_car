Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: odom
    Background Color: 35; 38; 43
    Frame Rate: 30
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Metre Grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 30
    Color: 95; 100; 110
  - Class: rviz_default_plugins/RobotModel
    Name: Assumed Vehicle
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/TF
    Name: Coordinate Frames
    Enabled: true
    Show Axes: true
    Show Names: false
    Marker Scale: 0.3
  - Class: rviz_default_plugins/Path
    Name: Simulator Truth GREEN
    Enabled: true
    Topic:
      Value: /trajectory/truth
    Color: 70; 230; 130
    Line Style: Lines
    Line Width: 0.025
    Buffer Length: 1
  - Class: rviz_default_plugins/Map
    Name: TEST Known Obstacle Map
    Enabled: true
    Topic:
      Value: /map
      Durability Policy: Transient Local
    Alpha: 0.7
  - Class: rviz_default_plugins/Path
    Name: Smac Hybrid Plan RED
    Enabled: true
    Topic:
      Value: /plan
    Color: 255; 100; 100
    Buffer Length: 1
  - Class: rviz_default_plugins/Map
    Name: Local Costmap
    Enabled: true
    Topic:
      Value: /local_costmap/costmap
    Alpha: 0.3
    Color Scheme: costmap
  - Class: rviz_default_plugins/Path
    Name: Route Server CYAN
    Enabled: true
    Topic:
      Value: /route/path
      Durability Policy: Transient Local
    Color: 60; 220; 255
    Buffer Length: 1
  - Class: rviz_default_plugins/Pose
    Name: Local Goal YELLOW
    Enabled: true
    Topic:
      Value: /route/local_goal
    Color: 255; 230; 20
    Shape: Arrow
    Arrow Length: 1.0
    Arrow Radius: 0.1
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 22
      Pitch: 1.1
      Yaw: 4.71
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Target Frame: base_footprint
Window Geometry:
  Width: 1000
  Height: 750
