<robot name="assumed_ackermann">
  <link name="base_footprint" />
  <link name="base_link">
    <visual>
      <origin xyz="0.4 0 0.1" rpy="0 0 0" />
      <geometry>
        <box size="1.1 0.38 0.16" />
      </geometry>
      <material name="base_link_color">
        <color rgba="0.15 0.35 0.85 1" />
      </material>
    </visual>
  </link>
  <joint name="footprint_to_base" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0.1" rpy="0 0 0" />
  </joint>
  <link name="front_left_wheel_steering_link" />
  <joint name="front_left_wheel_steering_joint" type="revolute">
    <parent link="base_link" />
    <child link="front_left_wheel_steering_link" />
    <origin xyz="0.8 0.25 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-0.6" upper="0.6" effort="25" velocity="2" />
  </joint>
  <link name="front_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.06" />
      </geometry>
      <material name="front_left_wheel_color">
        <color rgba="0.12 0.12 0.12 1" />
      </material>
    </visual>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_wheel_steering_link" />
    <child link="front_left_wheel" />
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 0" />
    <axis xyz="0 0 1" />
  </joint>
  <link name="rear_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.06" />
      </geometry>
      <material name="rear_left_wheel_color">
        <color rgba="0.12 0.12 0.12 1" />
      </material>
    </visual>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="rear_left_wheel" />
    <origin xyz="0 0.25 0" rpy="-1.5707963267948966 0 0" />
    <axis xyz="0 0 1" />
  </joint>
  <link name="front_right_wheel_steering_link" />
  <joint name="front_right_wheel_steering_joint" type="revolute">
    <parent link="base_link" />
    <child link="front_right_wheel_steering_link" />
    <origin xyz="0.8 -0.25 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-0.6" upper="0.6" effort="25" velocity="2" />
  </joint>
  <link name="front_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.06" />
      </geometry>
      <material name="front_right_wheel_color">
        <color rgba="0.12 0.12 0.12 1" />
      </material>
    </visual>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_wheel_steering_link" />
    <child link="front_right_wheel" />
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 0" />
    <axis xyz="0 0 1" />
  </joint>
  <link name="rear_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.1" length="0.06" />
      </geometry>
      <material name="rear_right_wheel_color">
        <color rgba="0.12 0.12 0.12 1" />
      </material>
    </visual>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="rear_right_wheel" />
    <origin xyz="0 -0.25 0" rpy="-1.5707963267948966 0 0" />
    <axis xyz="0 0 1" />
  </joint>
</robot>