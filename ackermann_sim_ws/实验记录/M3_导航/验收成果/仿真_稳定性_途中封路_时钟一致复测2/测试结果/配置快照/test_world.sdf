      <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
        <left_steering_joint>front_left_wheel_steering_joint</left_steering_joint>
        <right_steering_joint>front_right_wheel_steering_joint</right_steering_joint>
        <kingpin_width>0.5</kingpin_width>
        <steering_limit>0.436525365377011</steering_limit>
        <wheel_base>0.8</wheel_base>
        <wheel_separation>0.5</wheel_separation>
        <wheel_radius>0.1</wheel_radius>
        <min_velocity>-0.6</min_velocity>
        <max_velocity>0.6</max_velocity>
        <min_acceleration>-3.0</min_acceleration>
        <max_acceleration>3.0</max_acceleration>
        <left_joint>rear_left_wheel_joint</left_joint>
        <right_joint>rear_right_wheel_joint</right_joint>
        <steer_p_gain>8.0</steer_p_gain>
        <topic>/model/ackermann/cmd_vel</topic>
        <odom_topic>/model/ackermann/odometry</odom_topic>
        <tf_topic>/model/ackermann/tf</tf_topic>
        <frame_id>wheel_odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <odom_publish_frequency>50.0</odom_publish_frequency>
      </plugin>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
